{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "@electron-forge/plugin-vite/forge-vite-env"],
    "paths": { "@client/*": ["../client/*"], "@server/*": ["../server/src/*"] }
  },
  "include": ["src", "test", "e2e", "*.ts"]
}
