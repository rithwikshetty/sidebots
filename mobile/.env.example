# Copy to .env.local and fill in your own values.
SIDEBOTS_BUNDLE_ID=com.yourname.sidebots
SIDEBOTS_APPLE_TEAM_ID=
# The App Store Connect API key testflight.sh asks about an upload with, from Users and Access, Integrations.
# Its file is ~/.appstoreconnect/private_keys/AuthKey_<key id>.p8.
SIDEBOTS_ASC_KEY_ID=
SIDEBOTS_ASC_ISSUER_ID=
