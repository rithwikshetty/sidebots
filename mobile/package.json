{
  "name": "simon-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@legendapp/list": "3.7.2",
    "expo": "~58.0.25",
    "expo-application": "~58.1.2",
    "expo-camera": "58.0.11",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.2.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": false,
    "enableVideo": false,
    "codeHighlightLanguages": [
      "bash",
      "javascript",
      "typescript",
      "tsx",
      "python",
      "json",
      "yaml",
      "swift",
      "html",
      "css"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "react-native-enriched-markdown"
    ]
  }
}
